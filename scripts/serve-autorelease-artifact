#!/usr/bin/env python3
"""Serve one staged release through the GitHub API shape used by mise-php."""

import argparse
import json
import pathlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse


parser = argparse.ArgumentParser()
parser.add_argument("--port", required=True, type=int)
parser.add_argument("--assets", required=True, type=pathlib.Path)
parser.add_argument("--version", required=True)
args = parser.parse_args()
assets = args.assets.resolve()
archive_name = f"php-{args.version}-cli-macos-aarch64.tar.gz"


def payload() -> dict:
    base = f"http://127.0.0.1:{args.port}/assets"
    return {
        "tag_name": args.version,
        "draft": False,
        "prerelease": False,
        "assets": [
            {"name": archive_name, "browser_download_url": f"{base}/{archive_name}"},
            {"name": "SHA256SUMS", "browser_download_url": f"{base}/SHA256SUMS"},
        ],
    }


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        path = urlparse(self.path).path
        if path == "/health":
            return self.send_body(b"ok\n", "text/plain")
        if path == "/repos/bigpixelrocket/php-bin/releases":
            return self.send_json([payload()])
        if path == f"/repos/bigpixelrocket/php-bin/releases/tags/{args.version}":
            return self.send_json(payload())
        if path.startswith("/assets/"):
            name = path.removeprefix("/assets/")
            if name not in {archive_name, "SHA256SUMS"}:
                return self.send_error(404)
            candidate = assets / name
            if not candidate.is_file():
                return self.send_error(404)
            return self.send_body(
                candidate.read_bytes(),
                "application/gzip" if name.endswith(".gz") else "text/plain",
            )
        return self.send_error(404)

    def send_json(self, value: object) -> None:
        self.send_body(json.dumps(value).encode(), "application/json")

    def send_body(self, body: bytes, content_type: str) -> None:
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *arguments: object) -> None:
        return


ThreadingHTTPServer(("127.0.0.1", args.port), Handler).serve_forever()
