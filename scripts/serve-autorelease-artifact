#!/usr/bin/env python3
"""Serve one staged release through the GitHub API shape used by mise-php."""

import argparse
import json
import pathlib
import signal
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from autorelease.control import ControlError, validate_release_assets  # noqa: E402


parser = argparse.ArgumentParser()
parser.add_argument("--port", required=True, type=int)
parser.add_argument("--assets", required=True, type=pathlib.Path)
parser.add_argument("--version", required=True)
args = parser.parse_args()
assets = args.assets.resolve()
# The staged release is served only once it is exactly a release: one archive per
# platform and the SHA256SUMS binding them, so mise-php picks its platform's archive
# from the same listing GitHub will publish.
try:
    asset_names = sorted(validate_release_assets(assets, args.version))
except ControlError as error:
    parser.exit(1, f"staged release rejected: {error}\n")


def payload() -> dict:
    base = f"http://127.0.0.1:{args.port}/assets"
    return {
        "tag_name": args.version,
        "draft": False,
        "prerelease": False,
        "assets": [{"name": name, "browser_download_url": f"{base}/{name}"} for name in asset_names],
    }


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        path = urlparse(self.path).path
        if path == "/health":
            return self.send_body(b"ok\n", "text/plain")
        if path == "/repos/bigpixelrocket/php-bin/releases":
            return self.send_json([payload()])
        if path == f"/repos/bigpixelrocket/php-bin/releases/tags/{args.version}":
            return self.send_json(payload())
        if path.startswith("/assets/"):
            name = path.removeprefix("/assets/")
            if name not in asset_names:
                return self.send_error(404)
            candidate = assets / name
            if not candidate.is_file():
                return self.send_error(404)
            return self.send_body(
                candidate.read_bytes(),
                "application/gzip" if name.endswith(".gz") else "text/plain",
            )
        return self.send_error(404)

    def send_json(self, value: object) -> None:
        self.send_body(json.dumps(value).encode(), "application/json")

    def send_body(self, body: bytes, content_type: str) -> None:
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *arguments: object) -> None:
        return


server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)


def stop(signal_number: int, frame: object) -> None:
    """Release the port on the release job's kill instead of dying mid-request.

    shutdown() blocks until serve_forever() returns, and this handler runs on the
    thread inside it, so the request must be made from another thread.
    """
    threading.Thread(target=server.shutdown, daemon=True).start()


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
server.serve_forever()
server.server_close()
