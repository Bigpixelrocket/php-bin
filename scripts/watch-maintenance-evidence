#!/usr/bin/env python3
"""Choose a wake trigger from opaque digests, health, and incomplete state."""

import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from maintenance.control import ControlError, load_json, watch_decision, write_json  # noqa: E402


parser = argparse.ArgumentParser()
parser.add_argument("--manifest", type=pathlib.Path, required=True)
parser.add_argument("--previous", type=pathlib.Path, required=True)
parser.add_argument("--events", type=pathlib.Path, required=True)
parser.add_argument("--health", type=pathlib.Path)
parser.add_argument("--output", type=pathlib.Path, required=True)
args = parser.parse_args()

try:
    manifest = load_json(args.manifest)
    previous = load_json(args.previous) if args.previous.exists() else {}
    health = load_json(args.health) if args.health and args.health.exists() else {"healthy": True}
    events = []
    if args.events.exists():
        for path in args.events.glob("*.json"):
            events.append(load_json(path))
    if not previous.get("manifestDigest"):
        matching = [
            event.get("evidenceManifestDigest")
            for event in events
            if event.get("evidenceManifestDigest")
        ]
        if matching:
            previous["manifestDigest"] = matching[-1]
    decision = watch_decision(manifest, previous, events, health)
    write_json(args.output, decision)
    print(json.dumps(decision))
except (ControlError, OSError) as error:
    print(f"watch decision rejected: {error}", file=sys.stderr)
    raise SystemExit(1)
