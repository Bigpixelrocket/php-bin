#!/usr/bin/env python3
"""Advance one legal immutable release transition."""

import argparse
import json
import pathlib
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from autorelease.control import (  # noqa: E402
    COMMIT_SHA_RE,
    ROOT,
    ControlError,
    LEGAL_RELEASE_TRANSITIONS,
    PUBLISHED_RELEASE_TAG_RE,
    load_json,
    recipe_identity,
    recipe_identity_note,
    release_is_newest,
    release_recipe_identity,
    release_transition,
    sha256_file,
    validate_release_assets,
    write_json,
)


def gh(*arguments: str, capture: bool = True) -> str:
    result = subprocess.run(
        ["gh", *arguments],
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE,
    )
    return result.stdout.strip() if capture else ""


def all_releases(repo: str) -> list[dict]:
    """Return every release in the repository, drafts included for a write token."""
    pages = json.loads(gh("api", f"repos/{repo}/releases?per_page=100", "--paginate", "--slurp"))
    return [item for page in pages for item in page]


def tag_commit(repo: str, version: str) -> str | None:
    """Return the commit the release tag resolves to, or None when no such tag exists.

    `matching-refs` answers an absent tag with an empty list, so any failed call
    is an error rather than a missing tag.
    """
    refs = json.loads(gh("api", f"repos/{repo}/git/matching-refs/tags/{version}"))
    exact = [ref for ref in refs if ref.get("ref") == f"refs/tags/{version}"]
    if not exact:
        return None
    target = exact[0]["object"]
    if target["type"] == "tag":
        target = json.loads(gh("api", f"repos/{repo}/git/tags/{target['sha']}"))["object"]
    if target["type"] != "commit":
        raise ControlError(f"release tag does not name a commit: {version}")
    return target["sha"]


def require_tag_names_commit(repo: str, version: str, commit: str) -> None:
    """Fail unless the release tag exists and resolves to the admitted commit.

    Publication binds the tag forever, and GitHub creates a missing tag from the
    release's target branch when a draft is published. A stale-draft discard that
    stopped after deleting the tag, or replaced the draft, must therefore stop an
    older run's publication here rather than rely on its asset digests differing.
    """
    if tag_commit(repo, version) != commit:
        raise ControlError("release tag does not name the admitted commit")


def discard_stale_draft(repo: str, version: str, commit: str) -> bool:
    """Delete an unpublished draft whose tag no longer resolves to the admitted commit.

    A draft is left behind when an attempt stops before publication. Once main has
    moved, the next admitted dispatch names a newer commit, and the draft's tag and
    bytes belong to the old one. Such a draft was never public, so it is deleted
    with its tag and this run releases its own build of the admitted commit.

    Only positive evidence of a stale draft acts. No release, a published release,
    or a draft whose tag names the admitted commit is left untouched, so a published
    release with a mismatched tag still fails at `draft_created`. A draft tagged at
    a commit that is not an ancestor of the admitted one fails instead: that is a
    rerun of an older run, which must not replace a newer attempt's draft. Returns
    whether a draft was discarded.
    """
    if PUBLISHED_RELEASE_TAG_RE.fullmatch(version) is None:
        raise ControlError(f"release version is not a PHP version: {version}")
    if COMMIT_SHA_RE.fullmatch(commit) is None:
        raise ControlError("admitted commit is not an exact commit SHA")
    named = [release for release in all_releases(repo) if release.get("tag_name") == version]
    if not named:
        return False
    if len(named) != 1:
        raise ControlError(f"more than one release names tag {version}")
    release = named[0]
    if release.get("draft") is not True:
        return False
    tagged = tag_commit(repo, version)
    if tagged == commit:
        return False
    if tagged is not None:
        ancestry = json.loads(gh("api", f"repos/{repo}/compare/{tagged}...{commit}"))["status"]
        if ancestry != "ahead":
            raise ControlError(f"draft {version} is tagged at a commit that is not an ancestor of the admitted commit")
    release_id = int(release["id"])

    def require_unpublished_draft() -> None:
        # Re-read by ID right before each deletion: publication is irreversible,
        # and a release that is no longer this unpublished draft is never touched.
        current = json.loads(gh("api", f"repos/{repo}/releases/{release_id}"))
        if current.get("draft") is not True or current.get("tag_name") != version:
            raise ControlError("release stopped being an unpublished draft while it was discarded")

    # The tag goes first: a run that stops between the two deletions leaves a draft
    # without its tag, which the next run recognizes as stale and finishes deleting.
    # A stray tag with no release is never deleted here.
    if tagged is not None:
        require_unpublished_draft()
        gh("api", "--method", "DELETE", f"repos/{repo}/git/refs/tags/{version}")
    require_unpublished_draft()
    gh("api", "--method", "DELETE", f"repos/{repo}/releases/{release_id}")
    if tag_commit(repo, version) is not None or any(
        item.get("tag_name") == version for item in all_releases(repo)
    ):
        raise ControlError(f"stale draft {version} is still present after it was discarded")
    return True


def expected_assets(directory: pathlib.Path, version: str) -> dict[str, str]:
    # A transaction only ever creates a full release: one archive per platform and
    # the SHA256SUMS that binds them. The macOS-only shape of older releases is
    # accepted only where a published release is read back, never here.
    return validate_release_assets(directory, version)


def github_effect(
    target: str,
    repo: str,
    version: str,
    commit: str,
    assets_dir: pathlib.Path,
    digests: dict[str, str],
) -> None:
    if target == "built":
        return
    if target == "draft_created":
        tagged = tag_commit(repo, version)
        if tagged is None:
            message = json.dumps(
                {
                    "tag": version,
                    "message": (
                        f"PHP {version}\n\n"
                        + "\n".join(f"{name}: {digest}" for name, digest in sorted(digests.items()))
                    ),
                    "object": commit,
                    "type": "commit",
                }
            )
            # gh cannot combine --input - with an in-memory string without a shell.
            with tempfile.NamedTemporaryFile("w", suffix=".json") as handle:
                handle.write(message)
                handle.flush()
                tag_sha = json.loads(
                    gh("api", f"repos/{repo}/git/tags", "--method", "POST", "--input", handle.name)
                )["sha"]
            gh(
                "api",
                f"repos/{repo}/git/refs",
                "--method",
                "POST",
                "-f",
                f"ref=refs/tags/{version}",
                "-f",
                f"sha={tag_sha}",
            )
        elif tagged != commit:
            # A stale draft was discarded before the transaction began, so what is
            # left here is a published release or a stray tag: never retagged.
            raise ControlError("existing tag does not point to the admitted commit")
        # The watcher reads the recipe identity back from the published notes to
        # decide whether this version needs a rebuild revision.
        release_tag = PUBLISHED_RELEASE_TAG_RE.fullmatch(version)
        if release_tag is None:
            raise ControlError(f"release version is not a PHP version: {version}")
        identity = recipe_identity(ROOT, commit, release_tag.group(2))
        notes = (
            "Autorelease publication. Asset digests are recorded in SHA256SUMS.\n\n"
            + recipe_identity_note(identity)
        )
        existing = subprocess.run(
            ["gh", "release", "view", version, "--repo", repo, "--json", "isDraft,tagName,body"],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if existing.returncode == 0:
            # A matching published release is a recoverable partial transaction.
            # Later verification downloads it and proves every byte before the
            # idempotent publish transition is accepted. A resumed draft still has
            # editable notes, so it gains the identity it would otherwise publish
            # without; a missing identity would only select the version for rebuild.
            release = json.loads(existing.stdout)
            if release.get("isDraft") and release_recipe_identity(release) != identity:
                gh("release", "edit", version, "--repo", repo, "--notes", notes, capture=False)
        else:
            gh(
                "release",
                "create",
                version,
                *(str(assets_dir / name) for name in sorted(digests)),
                "--repo",
                repo,
                "--title",
                f"PHP {version}",
                "--notes",
                notes,
                "--draft",
                "--verify-tag",
                capture=False,
            )
    elif target in {"draft_verified", "publishing", "public_verified"}:
        # `publishing` re-reads the draft immediately before publication, because the
        # draft was verified by an earlier job and publication is irreversible.
        if target == "publishing":
            require_tag_names_commit(repo, version, commit)
        with tempfile.TemporaryDirectory(prefix="autorelease-download-") as temporary:
            gh(
                "release",
                "download",
                version,
                "--repo",
                repo,
                "--dir",
                temporary,
                "--clobber",
                capture=False,
            )
            for name, digest in digests.items():
                if sha256_file(pathlib.Path(temporary) / name) != digest:
                    raise ControlError(f"downloaded release asset differs: {name}")
    elif target == "published":
        release = json.loads(gh("release", "view", version, "--repo", repo, "--json", "isDraft,databaseId"))
        if release["isDraft"]:
            require_tag_names_commit(repo, version, commit)
            # Left to GitHub, the "Latest" badge follows the last publication, so a
            # rebuild of an older branch would take it from the newest version. The
            # publication therefore states it: latest only when no published release
            # sorts above this version.
            latest = "true" if release_is_newest(version, all_releases(repo)) else "false"
            gh(
                "api",
                "--method",
                "PATCH",
                f"repos/{repo}/releases/{int(release['databaseId'])}",
                "-F",
                "draft=false",
                "-f",
                f"make_latest={latest}",
                capture=False,
            )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--discard-stale-draft",
        action="store_true",
        help="before a transaction: delete an unpublished draft whose tag is not the admitted commit",
    )
    parser.add_argument("--transaction", type=pathlib.Path)
    parser.add_argument("--target")
    parser.add_argument("--assets", type=pathlib.Path)
    parser.add_argument("--version", required=True)
    parser.add_argument("--commit", required=True)
    parser.add_argument("--backend", choices=["filesystem", "github"], default="filesystem")
    parser.add_argument("--repo", default="bigpixelrocket/php-bin")
    parser.add_argument("--output", type=pathlib.Path)
    args = parser.parse_args()

    if args.discard_stale_draft:
        try:
            discarded = discard_stale_draft(args.repo, args.version, args.commit)
        except (ControlError, KeyError, TypeError, ValueError, subprocess.CalledProcessError) as error:
            detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) and error.stderr else str(error)
            print(f"stale draft discard rejected: {detail}", file=sys.stderr)
            return 1
        print(json.dumps({"version": args.version, "discardedStaleDraft": discarded}))
        return 0
    missing = [flag for flag in ("transaction", "target", "assets", "output") if getattr(args, flag) is None]
    if missing:
        parser.error("a transition requires " + ", ".join(f"--{flag}" for flag in missing))

    try:
        transaction = load_json(args.transaction)
        if LEGAL_RELEASE_TRANSITIONS.get(transaction.get("state", "requested")) != args.target:
            raise ControlError("target is not the single legal next transition")
        digests = expected_assets(args.assets, args.version)
        if args.backend == "github":
            github_effect(args.target, args.repo, args.version, args.commit, args.assets, digests)
        updated = release_transition(transaction, args.target, args.assets, digests)
        updated["version"] = args.version
        updated["commit"] = args.commit
        write_json(args.output, updated)
        print(json.dumps(updated))
        return 0
    except (ControlError, OSError, subprocess.CalledProcessError) as error:
        detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) and error.stderr else str(error)
        print(f"release transition rejected: {detail}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
