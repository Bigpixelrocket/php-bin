#!/usr/bin/env python3
"""Choose a wake trigger from opaque digests, health, incomplete state, and due rebuilds."""

import argparse
import json
import pathlib
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from autorelease.control import (  # noqa: E402
    ROOT,
    ControlError,
    captured_php_bin_releases,
    git,
    load_json,
    recipe_identities,
    validate_evidence_state_record,
    watch_decision,
    write_json,
)


parser = argparse.ArgumentParser()
parser.add_argument("--manifest", type=pathlib.Path, required=True)
parser.add_argument("--previous", type=pathlib.Path, required=True)
parser.add_argument("--events", type=pathlib.Path, required=True)
parser.add_argument("--health", type=pathlib.Path)
parser.add_argument("--self-evidence-update", action="store_true")
parser.add_argument("--output", type=pathlib.Path, required=True)
args = parser.parse_args()

try:
    manifest = load_json(args.manifest)
    previous = load_json(args.previous) if args.previous.exists() else {}
    if previous:
        validate_evidence_state_record(previous)
    if args.health:
        if not args.health.is_file():
            raise ControlError(f"supplied health input is missing: {args.health}")
        health = load_json(args.health)
    else:
        health = {"healthy": True}
    if not args.events.is_dir():
        raise ControlError(f"supplied events directory is missing or invalid: {args.events}")
    events = []
    record_files = []
    for path in sorted(args.events.glob("*.json")):
        events.append(load_json(path))
        record_files.append(path.name)
    if not previous.get("manifestDigest"):
        matching = sorted({
            event.get("evidenceManifestDigest")
            for event in events
            if event.get("evidenceManifestDigest")
        })
        if len(matching) > 1:
            raise ControlError("previous evidence state is missing and event reconstruction is ambiguous")
        if matching:
            previous["manifestDigest"] = matching[0]
    # Only a healthy capture can prove a release; an unhealthy one already decides the
    # run through the source_unhealthy trigger, so its body is never parsed.
    releases = captured_php_bin_releases(args.manifest)
    # The recipe is the checked-out commit, which is exactly the phpBinHead precondition
    # the investigation, admission, and the publish transaction are later bound to.
    head = git(ROOT, "rev-parse", "HEAD").stdout.strip()
    decision = watch_decision(
        manifest,
        previous,
        events,
        health,
        self_evidence_update=args.self_evidence_update,
        releases=releases,
        record_files=record_files,
        recipe_identities=recipe_identities(ROOT, head),
    )
    write_json(args.output, decision)
    print(json.dumps(decision))
except (ControlError, OSError, subprocess.CalledProcessError) as error:
    print(f"watch decision rejected: {error}", file=sys.stderr)
    raise SystemExit(1)
