#!/usr/bin/env python3
"""Seal the deterministic repository diff of one admitted plan."""

import argparse
import json
import pathlib
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from autorelease.control import ControlError, load_json, seal_patch  # noqa: E402


parser = argparse.ArgumentParser()
parser.add_argument("--repo", type=pathlib.Path, default=pathlib.Path.cwd())
parser.add_argument("--base", required=True)
parser.add_argument("--plan", type=pathlib.Path, required=True)
parser.add_argument("--output", type=pathlib.Path, required=True)
args = parser.parse_args()

try:
    manifest = seal_patch(
        args.repo,
        args.base,
        load_json(args.plan),
        args.output,
    )
    print(json.dumps(manifest))
except (ControlError, OSError, subprocess.CalledProcessError) as error:
    detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) and error.stderr else str(error)
    print(f"patch sealing rejected: {detail}", file=sys.stderr)
    raise SystemExit(1)
