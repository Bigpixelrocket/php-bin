#!/usr/bin/env python3
"""Idempotently install reviewed GitHub repository settings."""

import argparse
import json
import pathlib
import subprocess
import sys
import tempfile
import urllib.parse


def gh(*arguments: str, input_value: dict | None = None) -> str:
    command = ["gh", *arguments]
    if input_value is None:
        result = subprocess.run(command, check=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    else:
        with tempfile.NamedTemporaryFile("w", suffix=".json") as handle:
            json.dump(input_value, handle)
            handle.flush()
            result = subprocess.run(
                [*command, "--input", handle.name],
                check=True,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
    return result.stdout.strip()


def ensure_label(repo: str, name: str, color: str, description: str) -> None:
    existing = subprocess.run(
        ["gh", "label", "list", "--repo", repo, "--search", name, "--json", "name"],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    names = {item["name"] for item in json.loads(existing.stdout or "[]")}
    if name in names:
        gh("label", "edit", name, "--repo", repo, "--color", color, "--description", description)
    else:
        gh("label", "create", name, "--repo", repo, "--color", color, "--description", description)


parser = argparse.ArgumentParser()
parser.add_argument("--repo", required=True)
parser.add_argument("--owner", required=True)
# The ruleset is written whole, so every status check it should require is
# named here; Protected controls is always added. Re-running with fewer checks
# than the ruleset already requires stops unless each dropped check is named,
# so a stale invocation cannot quietly remove a required check.
parser.add_argument(
    "--required-check",
    action="append",
    required=True,
    metavar="NAME",
    help="Status check the protect_main ruleset requires. Repeat once per check.",
)
parser.add_argument(
    "--drop-required-check",
    action="append",
    default=[],
    metavar="NAME",
    help="Required check the ruleset may stop requiring. Repeat once per check.",
)
# Environments are GitHub configuration rather than repository files, so a
# source-only rename cannot move them. Naming each one at the call site keeps
# the provisioned set and the reviewed docs/admin-state snapshot in step.
parser.add_argument(
    "--environment",
    action="append",
    required=True,
    metavar="NAME",
    help="Protected environment to create. Repeat once per environment.",
)
args = parser.parse_args()
required_checks = list(dict.fromkeys([*args.required_check, "Protected controls"]))
if not all(required_checks) or set(args.drop_required_check) & set(required_checks):
    parser.error("required checks must be named, and a dropped check cannot also be required")

try:
    # Read before any change, so a refused drop leaves the repository untouched.
    existing = json.loads(gh("api", f"repos/{args.repo}/rulesets") or "[]")
    matched = [item for item in existing if item.get("name") == "protect_main"]
    if len(matched) > 1:
        raise RuntimeError("multiple protect_main rulesets exist; resolve by hand")
    if matched:
        current = json.loads(gh("api", f"repos/{args.repo}/rulesets/{matched[0]['id']}"))
        current_checks = {
            check["context"]
            for rule in current.get("rules", [])
            if rule.get("type") == "required_status_checks"
            for check in rule["parameters"]["required_status_checks"]
        }
        dropped = sorted(current_checks - set(required_checks) - set(args.drop_required_check))
        if dropped:
            raise RuntimeError(
                "the protect_main ruleset requires checks this run would drop: "
                + ", ".join(dropped)
                + "; pass each as --required-check to keep it or --drop-required-check to remove it"
            )
    repository = json.loads(gh(
        "api",
        f"repos/{args.repo}",
        "--method",
        "PATCH",
        input_value={
            "allow_auto_merge": True,
            "delete_branch_on_merge": True,
            "allow_squash_merge": True,
            "allow_merge_commit": False,
            "allow_rebase_merge": False,
            "allow_update_branch": True,
            "squash_merge_commit_title": "PR_TITLE",
            "squash_merge_commit_message": "PR_BODY",
            "security_and_analysis": {
                "dependabot_security_updates": {"status": "enabled"},
                "secret_scanning": {"status": "enabled"},
                "secret_scanning_push_protection": {"status": "enabled"},
                "secret_scanning_validity_checks": {"status": "enabled"},
                "secret_scanning_non_provider_patterns": {"status": "enabled"},
            },
        },
    ))
    security = repository.get("security_and_analysis", {})
    required_security = (
        "dependabot_security_updates",
        "secret_scanning",
        "secret_scanning_push_protection",
    )
    if any(security.get(name, {}).get("status") != "enabled" for name in required_security):
        raise RuntimeError("GitHub did not enable the supported baseline security controls")
    unavailable_security = sorted(
        name
        for name in ("secret_scanning_validity_checks", "secret_scanning_non_provider_patterns")
        if security.get(name, {}).get("status") != "enabled"
    )
    gh(
        "api",
        f"repos/{args.repo}/actions/permissions",
        "--method",
        "PUT",
        input_value={"enabled": True, "allowed_actions": "selected", "sha_pinning_required": True},
    )
    gh(
        "api",
        f"repos/{args.repo}/actions/permissions/selected-actions",
        "--method",
        "PUT",
        input_value={
            "github_owned_allowed": True,
            "verified_allowed": False,
            "patterns_allowed": ["jdx/mise-action@*"],
        },
    )
    gh(
        "api",
        f"repos/{args.repo}/actions/permissions/workflow",
        "--method",
        "PUT",
        input_value={
            "default_workflow_permissions": "read",
            # Despite its name, this flag governs the single "create and
            # approve pull requests" permission. The watcher and consumer
            # open deterministic PRs with GITHUB_TOKEN daily, so it must stay
            # enabled; approvals remain owner-only through the ruleset and
            # protected controls.
            "can_approve_pull_request_reviews": True,
        },
    )
    gh("api", f"repos/{args.repo}/immutable-releases", "--method", "PUT")
    # The watcher publishes the branch status document through an Actions Pages
    # deployment, never from a branch, so the site may only be built by a workflow.
    # Its `github-pages` environment is then pinned like any other: pass it as an
    # --environment so only protected branches can deploy.
    pages = subprocess.run(
        ["gh", "api", f"repos/{args.repo}/pages"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if pages.returncode == 0:
        gh("api", f"repos/{args.repo}/pages", "--method", "PUT", input_value={"build_type": "workflow"})
    elif "Not Found" in pages.stderr:
        gh("api", f"repos/{args.repo}/pages", "--method", "POST", input_value={"build_type": "workflow"})
    else:
        raise RuntimeError(f"GitHub Pages state is unreadable: {pages.stderr.strip()}")
    if json.loads(gh("api", f"repos/{args.repo}/pages")).get("build_type") != "workflow":
        raise RuntimeError("GitHub did not set the Pages site to build from workflows")
    gh("variable", "set", "AUTORELEASE_OWNER", "--repo", args.repo, "--body", args.owner)
    ensure_label(args.repo, "autorelease", "1d76db", "Autorelease event")
    ensure_label(args.repo, "attention-required", "d73a4a", "Owner action is required")
    for environment_name in args.environment:
        environment = json.loads(gh(
            "api",
            # A name may contain a slash, which must stay one path segment.
            f"repos/{args.repo}/environments/{urllib.parse.quote(environment_name, safe='')}",
            "--method",
            "PUT",
            input_value={
                "wait_timer": 0,
                "prevent_self_review": False,
                "reviewers": [],
                "can_admins_bypass": False,
                "deployment_branch_policy": {
                    "protected_branches": True,
                    "custom_branch_policies": False,
                },
            },
        ))
        if environment.get("can_admins_bypass") is not False:
            raise RuntimeError(
                f"GitHub did not disable administrator environment bypass for {environment_name}"
            )
    ruleset = {
        "name": "protect_main",
        "target": "branch",
        "enforcement": "active",
        "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
        # Repository administrators may merge a pull request past a failing
        # rule (a solo owner cannot approve their own protected-path PR, so
        # that red check always ended in an administrative bypass anyway) but
        # can never push, force-push, or delete main directly.
        "bypass_actors": [
            {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"}
        ],
        "rules": [
            {"type": "deletion"},
            {"type": "non_fast_forward"},
            {"type": "required_linear_history"},
            {
                "type": "pull_request",
                "parameters": {
                    "required_approving_review_count": 0,
                    "dismiss_stale_reviews_on_push": True,
                    "require_code_owner_review": True,
                    "require_last_push_approval": False,
                    "required_review_thread_resolution": True,
                    "allowed_merge_methods": ["squash"],
                },
            },
            {
                "type": "required_status_checks",
                "parameters": {
                    "strict_required_status_checks_policy": True,
                    "do_not_enforce_on_create": False,
                    "required_status_checks": [
                        {"context": context, "integration_id": 15368} for context in required_checks
                    ],
                },
            },
        ],
    }
    if matched:
        gh(
            "api",
            f"repos/{args.repo}/rulesets/{matched[0]['id']}",
            "--method",
            "PUT",
            input_value=ruleset,
        )
    else:
        gh("api", f"repos/{args.repo}/rulesets", "--method", "POST", input_value=ruleset)
    # Classic branch protection is superseded by the ruleset. Removing it also
    # retires the enforce_admins toggle the old merge procedure depended on.
    classic = subprocess.run(
        ["gh", "api", f"repos/{args.repo}/branches/main/protection"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if classic.returncode == 0:
        gh("api", f"repos/{args.repo}/branches/main/protection", "--method", "DELETE")
    elif "Branch not protected" not in classic.stderr:
        raise RuntimeError(f"classic branch protection state is unreadable: {classic.stderr.strip()}")
    print(
        json.dumps(
            {
                "configured": True,
                "repo": args.repo,
                "owner": args.owner,
                "requiredChecks": required_checks,
                "environments": args.environment,
                "unavailableSecurityFeatures": unavailable_security,
            }
        )
    )
except (subprocess.CalledProcessError, OSError, RuntimeError, json.JSONDecodeError) as error:
    detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) and error.stderr else str(error)
    print(f"GitHub autorelease configuration failed: {detail}", file=sys.stderr)
    raise SystemExit(1)
