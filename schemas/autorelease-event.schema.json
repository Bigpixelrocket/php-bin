{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigpixelrocket.dev/schemas/autorelease-event.schema.json",
  "type": "object",
  "required": ["schemaVersion", "actionKey", "state", "history"],
  "properties": {
    "schemaVersion": {"const": 1},
    "actionKey": {"type": "string"},
    "state": {"enum": ["detected", "php_bin_ready", "mise_ready", "release_requested", "released", "public_install_verified", "complete", "blocked", "needs_human"]},
    "history": {"type": "array"}
  }
}
